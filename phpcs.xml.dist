<?xml version="1.0"?>
<ruleset name="RealUptime Errors">
    <!--
        The PHP SDK's linter configuration (PHP_CodeSniffer). The gate runs it
        through scripts/lint-sdks.mjs. PSR-12 is the standard; the line-length
        warning is off because the code wraps by sentence, not by column.
    -->
    <description>PSR-12 for the RealUptime Errors PHP SDK.</description>
    <file>src</file>
    <file>tests</file>
    <file>config</file>
    <arg name="extensions" value="php"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- functions.php sets two globals and declares the helper beside them. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>src/functions.php</exclude-pattern>
    </rule>
</ruleset>
